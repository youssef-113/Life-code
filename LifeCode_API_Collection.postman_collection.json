    {
      "name": "🚨 Emergency Contacts",
      "item": [
        {
          "name": "Add Emergency Contact",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('contactId', res.data.id);",
                  "    console.log('✅ contactId saved:', res.data.id);",
                  "  }",
                  "  pm.test('Contact created', () => pm.expect(res.success).to.be.true);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ContactName\": \"Jane besso\",\n  \"Relation\": \"Spouse\",\n  \"PhoneNumber\": \"+201234567890\",\n  \"SecondaryPhone\": \"+201234567891\",\n  \"Email\": \"jane@example.com\",\n  \"IsPrimary\": true,\n  \"Priority\": 1,\n  \"Notes\": \"Primary emergency contact\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/emergency/contact",
              "host": ["{{baseUrl}}"],
              "path": ["emergency", "contact"]
            },
            "description": "Add a new emergency contact.\n\n**ContactName:** 2–100 chars (required)\n\n**PhoneNumber:** E.164 format, 10–15 digits (required)\n\n**Relation:** Max 50 chars (optional)\n\n**IsPrimary:** true/false (optional)\n\n**Auto-saves** the contact ID to `{{contactId}}`."
          }
        },
        {
          "name": "Get All Emergency Contacts",
