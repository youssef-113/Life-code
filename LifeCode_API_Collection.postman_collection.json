{
  "info": {
    "_postman_id": "lifecode-api-collection-v1",
    "name": "LifeCode API - Complete Collection",
    "description": "Complete Postman collection for the LifeCode Emergency Health Platform API.\n\n**Base URL:** https://life-code--yossfabdla311.replit.app/api/app\n\n**How to use:**\n1. Set the `baseUrl` and `token` collection variables before running.\n2. Run **Register** or **Login** first — the token is auto-saved to `{{token}}`.\n3. All authenticated requests will use `{{token}}` automatically.\n\n**Variables:**\n- `baseUrl` — API base URL (pre-filled)\n- `token` — Session token (auto-set after login/register)\n- `refreshToken` — Refresh token (auto-set after login/register)\n- `contactId` — Emergency contact ID (set manually after creating one)\n- `familyMemberId` — Family member ID (set manually after creating one)\n- `wristbandId` — Wristband ID (set manually after registering one)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://life-code--yossfabdla311.replit.app/api/app",
      "type": "string"
    },
    {
      "key": "token",
      "value": "PASTE_YOUR_SESSION_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "PASTE_YOUR_REFRESH_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "contactId",
      "value": "CONTACT_ID_HERE",
      "type": "string"
    },
    {
      "key": "familyMemberId",
      "value": "FAMILY_MEMBER_ID_HERE",
      "type": "string"
    },
    {
      "key": "wristbandId",
      "value": "WRISTBAND_ID_HERE",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Register (Email/Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('token', res.data.sessionToken);",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "  pm.test('Registration successful', () => pm.expect(res.success).to.be.true);",
                  "  pm.test('Token received', () => pm.expect(res.data.sessionToken).to.be.a('string'));",
                  "  console.log('✅ Token saved:', res.data.sessionToken.substring(0, 20) + '...');",
                  "} else {",
                  "  pm.test('Registration failed - check body', () => pm.expect(pm.response.code).to.equal(201));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"yousseff besso\",\n  \"email\": \"yousseff@example.com\",\n  \"password\": \"SecurePass123\",\n  \"confirmPassword\": \"SecurePass123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["register"]
            },
            "description": "Create a new user account with email and password.\n\n**Returns:** sessionToken + refreshToken (auto-saved to collection variables)"
          }
        },
        {
          "name": "Login (Email/Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('token', res.data.sessionToken);",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "  pm.test('Login successful', () => pm.expect(res.success).to.be.true);",
                  "  pm.test('Token received', () => pm.expect(res.data.sessionToken).to.be.a('string'));",
                  "  console.log('✅ Token saved:', res.data.sessionToken.substring(0, 20) + '...');",
                  "} else {",
                  "  pm.test('Login failed - check credentials', () => pm.expect(pm.response.code).to.equal(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"yousseff@example.com\",\n  \"password\": \"SecurePass123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            },
            "description": "Authenticate existing user with email and password.\n\n**Returns:** sessionToken + refreshToken (auto-saved to collection variables)"
          }
        },
        {
          "name": "Google Sign-In",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"GOOGLE_ID_TOKEN_FROM_SDK\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google"]
            },
            "description": "Authenticate with Google OAuth (Auto Login OR Register).\n\n**Note:** Replace `idToken` with a real token obtained from the Google Sign-In SDK."
          }
        },
        {
          "name": "Apple Sign-In",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"APPLE_ID_TOKEN_FROM_SDK\",\n  \"authorizationCode\": \"OPTIONAL_AUTH_CODE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/apple",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "apple"]
            },
            "description": "Authenticate with Apple Sign-In (Auto Login OR Register).\n\n**Note:** Replace `idToken` with a real token obtained from the Apple Sign-In SDK."
          }
        },
        {
          "name": "Get Linked Providers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/providers",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "providers"]
            },
            "description": "Get all authentication methods (email, google, apple) linked to the user's account."
          }
        },
        {
          "name": "Unlink Provider",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/providers/google",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "providers", "google"]
            },
            "description": "Remove an authentication provider from the account.\n\n**URL Param:** Replace `google` with `apple` or `email` as needed.\n\n**Warning:** You must have at least one other provider linked before unlinking."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('token', res.data.sessionToken);",
                  "  pm.test('Token refreshed', () => pm.expect(res.success).to.be.true);",
                  "  console.log('✅ New token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["refresh"]
            },
            "description": "Get a new session token using the refresh token.\n\n**Auto-saves** the new token to the `token` collection variable."
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', '');",
                  "  pm.test('Logged out successfully', () => pm.expect(pm.response.json().success).to.be.true);",
                  "  console.log('✅ Token cleared from collection variables');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": ["{{baseUrl}}"],
              "path": ["logout"]
            },
            "description": "Logout from the current session and invalidate the session token."
          }
        },
        {
          "name": "Logout All Devices",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', '');",
                  "  pm.collectionVariables.set('refreshToken', '');",
                  "  pm.test('Logged out from all devices', () => pm.expect(pm.response.json().success).to.be.true);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logout-all",
              "host": ["{{baseUrl}}"],
              "path": ["logout-all"]
            },
            "description": "Logout from ALL active sessions across all devices. Revokes all session tokens."
          }
        }
      ]
    },
