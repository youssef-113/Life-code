{
  "info": {
    "_postman_id": "healthcare-api-collection",
    "name": "Healthcare API",
    "description": "Postman collection for Healthcare API - Authentication, User Profile, Medical Info, and Emergency Contacts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Check if the API is running"
      }
    },
    {
      "name": "API Documentation",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api",
          "host": ["{{baseUrl}}"],
          "path": ["api"]
        },
        "description": "Get API documentation"
      }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"idToken\": \"firebase-id-token-from-client\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticate user and create session"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionToken\": \"{{accessToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Logout and deactivate session"
          }
        },
        {
          "name": "Logout All Sessions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout-all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout-all"]
            },
            "description": "Logout from all active sessions"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Refresh access token using refresh token"
          }
        },
        {
          "name": "Get Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sessions"]
            },
            "description": "Get all active sessions for current user"
          }
        },
        {
          "name": "Revoke Session",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sessions", "{{sessionId}}"]
            },
            "description": "Revoke a specific session"
          }
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Get current user's profile"
          }
        },
        {
          "name": "Get Complete Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "complete"]
            },
            "description": "Get complete profile with medical info and emergency contacts"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"JohnDoe\",\n  \"gender\": \"male\",\n  \"nationalId\": \"1234567890\",\n  \"photoUrl\": \"https://example.com/photo.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Update user profile"
          }
        },
        {
          "name": "Deactivate Account",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Deactivate user account (soft delete)"
          }
        }
      ]
    },
    {
      "name": "Medical Information",
      "item": [
        {
          "name": "Get Medical Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/medical",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medical"]
            },
            "description": "Get user's medical information"
          }
        },
        {
          "name": "Create/Update Medical Info",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bloodType\": \"O+\",\n  \"chronicDiseases\": \"None\",\n  \"allergies\": \"Penicillin\",\n  \"medications\": \"Vitamin D daily\",\n  \"notes\": \"No known complications\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/medical",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medical"]
            },
            "description": "Create or update medical information"
          }
        },
        {
          "name": "Update Medical Info (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bloodType\": \"A+\",\n  \"allergies\": \"None\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/medical",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medical"]
            },
            "description": "Update medical information"
          }
        },
        {
          "name": "Patch Medical Info",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medications\": \"Updated medication list\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/medical",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medical"]
            },
            "description": "Partial update of medical information"
          }
        },
        {
          "name": "Delete Medical Info",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/medical",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medical"]
            },
            "description": "Delete medical information"
          }
        }
      ]
    },
    {
      "name": "Emergency Contacts",
      "item": [
        {
          "name": "Get All Contacts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/emergency",
              "host": ["{{baseUrl}}"],
              "path": ["api", "emergency"]
            },
            "description": "Get all emergency contacts"
          }
        },
        {
          "name": "Create Contact",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contactName\": \"Jane Doe\",\n  \"relation\": \"Spouse\",\n  \"phoneNumber\": \"+1234567890\",\n  \"secondaryPhone\": \"+0987654321\",\n  \"isPrimary\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/emergency",
              "host": ["{{baseUrl}}"],
              "path": ["api", "emergency"]
            },
            "description": "Create a new emergency contact"
          }
        },
        {
          "name": "Get Contact by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/emergency/{{contactId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "emergency", "{{contactId}}"]
            },
            "description": "Get a specific emergency contact"
          }
        },
        {
          "name": "Update Contact",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+1111111111\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/emergency/{{contactId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "emergency", "{{contactId}}"]
            },
            "description": "Update an emergency contact"
          }
        },
        {
          "name": "Delete Contact",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/emergency/{{contactId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "emergency", "{{contactId}}"]
            },
            "description": "Delete an emergency contact"
          }
        },
        {
          "name": "Set Primary Contact",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/emergency/{{contactId}}/primary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "emergency", "{{contactId}}", "primary"]
            },
            "description": "Set a contact as the primary emergency contact"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "contactId",
      "value": "",
      "type": "string"
    }
  ]
}
