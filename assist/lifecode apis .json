    "implementation_notes": {
      "note_1": "All timestamps are in ISO 8601 format (UTC)",
      "note_2": "Authentication uses JWT Bearer tokens in Authorization header",
      "note_3": "Public scan endpoints don't require authentication for emergency access",
      "note_4": "Session tokens expire after 1 hour, use refresh token to renew",
      "note_5": "All POST endpoints return 201 status on successful resource creation",
      "note_6": "GET endpoints with pagination return hasMore boolean and nextOffset",
      "note_7": "QR codes and NFC tags must be unique across the entire system",
      "note_8": "Medical information and emergency contacts are only shown in public scans",
      "note_9": "Security logs are automatically created for login/logout/password changes",
      "note_10": "Admin endpoints require additional role-based authentication"
    }
