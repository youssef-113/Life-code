{
  "lifecode_api_specification": {
    "version": "1.0.0",
    "last_updated": "2025-02-03",
    "description": "Complete JSON structure for LifeCode API - POST endpoints for Mobile App, GET endpoints for Web Dashboard",
    "base_url": "https://api.lifecode.app",
    
    "authentication": {
      "description": "JWT-based authentication using Bearer tokens",
      "header": "Authorization: Bearer {session_token}",
      "token_expiry": "1 hour",
      "refresh_token_expiry": "30 days"
    },

    "app_endpoints_post": {
      "description": "Mobile app endpoints - All use POST method for data submission",
      
      "1_register_user": {
        "endpoint": "POST /api/app/register",
        "description": "Register new user account",
        "authentication": "Not required",
        "request": {
          "username": "yousseff_besso",
          "email": "yousseff.besso@example.com",
          "password": "SecurePass123!",
          "gender": "male",
          "nationalID": "12345678901234",
          "photoURL": "https://storage.example.com/photos/yousseff.jpg"
        },
        "response_success": {
          "success": true,
          "message": "User registered successfully",
          "data": {
            "userID": 1,
            "username": "yousseff_besso",
            "email": "yousseff.besso@example.com",
            "sessionToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySUQiOjEsImlhdCI6MTcwNjg2MDgwMCwiZXhwIjoxNzA2ODY0NDAwfQ.abc123",
            "refreshToken": "refresh_abc123xyz789",
            "expiresAt": "2025-02-03T18:00:00Z",
            "createdAt": "2025-02-03T17:00:00Z"
          }
        },
        "response_error": {
          "success": false,
          "error": "Validation Error",
          "message": "Email already exists",
          "code": 400
        }
      },

      "2_register_google": {
        "endpoint": "POST /api/app/register/google",
        "description": "Register user with Google OAuth",
        "authentication": "Not required",
        "request": {
          "googleID": "1234567890abcdef",
          "email": "yousseff.besso@gmail.com",
          "username": "yousseff_besso_google",
          "photoURL": "https://lh3.googleusercontent.com/a/photo.jpg",
          "gender": "male"
        },
        "response_success": {
          "success": true,
          "message": "User registered with Google successfully",
          "data": {
            "userID": 2,
            "username": "yousseff_besso_google",
            "email": "yousseff.besso@gmail.com",
            "googleID": "1234567890abcdef",
            "sessionToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "refreshToken": "refresh_xyz456...",
            "expiresAt": "2025-02-03T18:00:00Z"
          }
        }
      },

      "3_login": {
        "endpoint": "POST /api/app/login",
        "description": "User login and create session",
        "authentication": "Not required",
        "request": {
          "email": "yousseff.besso@example.com",
          "password": "SecurePass123!",
          "deviceName": "iPhone 15 Pro",
          "deviceType": "ios",
          "deviceToken": "fcm_token_abc123xyz789",
          "deviceOS": "iOS 17.2",
          "appVersion": "2.1.0"
        },
        "response_success": {
          "success": true,
          "message": "Login successful",
          "data": {
            "userID": 1,
            "username": "yousseff_besso",
            "email": "yousseff.besso@example.com",
            "sessionToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "refreshToken": "refresh_abc123xyz789",
            "expiresAt": "2025-02-03T18:00:00Z",
            "sessionID": 1,
            "deviceID": 1
          }
        },
        "response_error": {
          "success": false,
          "error": "Authentication Failed",
          "message": "Invalid email or password",
          "code": 401
        }
      },

      "4_logout": {
        "endpoint": "POST /api/app/logout",
        "description": "Logout and invalidate session",
        "authentication": "Required",
        "request": {
          "sessionToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "response_success": {
          "success": true,
          "message": "Logged out successfully",
          "data": {
            "loggedOutAt": "2025-02-03T17:30:00Z"
          }
        }
      },

      "5_refresh_token": {
        "endpoint": "POST /api/app/refresh",
        "description": "Refresh expired session token",
        "authentication": "Refresh token required",
        "request": {
          "refreshToken": "refresh_abc123xyz789"
        },
        "response_success": {
          "success": true,
          "message": "Token refreshed successfully",
          "data": {
            "sessionToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.new_token",
            "expiresAt": "2025-02-03T19:00:00Z"
          }
        }
      },

      "6_register_wristband": {
        "endpoint": "POST /api/app/wristband",
        "description": "Link wristband to user account",
        "authentication": "Required",
        "request": {
          "qrCode": "LIFECODE-QR-00001",
          "nfcTag": "LIFECODE-NFC-00001",
          "serialNumber": "SN-2025-00001"
        },
        "response_success": {
          "success": true,
          "message": "Wristband registered successfully",
          "data": {
            "wristbandID": 1,
            "userID": 1,
            "qrCode": "LIFECODE-QR-00001",
            "nfcTag": "LIFECODE-NFC-00001",
            "serialNumber": "SN-2025-00001",
            "isActive": true,
            "isRevoked": false,
            "createdAt": "2025-02-03T17:00:00Z"
          }
        },
        "response_error": {
          "success": false,
          "error": "Conflict",
          "message": "Wristband already registered to another user",
          "code": 409
        }
      },

      "7_activate_wristband": {
        "endpoint": "POST /api/app/wristband/activate",
        "description": "Activate an inactive wristband",
        "authentication": "Required",
        "request": {
          "wristbandID": 1
        },
        "response_success": {
          "success": true,
          "message": "Wristband activated successfully",
          "data": {
            "wristbandID": 1,
            "isActive": true,
            "activatedAt": "2025-02-03T17:15:00Z"
          }
        }
      },

      "8_revoke_wristband": {
        "endpoint": "POST /api/app/wristband/revoke",
        "description": "Revoke wristband (security feature)",
        "authentication": "Required",
        "request": {
          "wristbandID": 1,
          "reason": "Lost wristband"
        },
        "response_success": {
          "success": true,
          "message": "Wristband revoked successfully",
          "data": {
            "wristbandID": 1,
            "isRevoked": true,
            "isActive": false,
            "revokedAt": "2025-02-03T17:20:00Z",
            "revokeReason": "Lost wristband"
          }
        }
      },

      "9_add_medical_info": {
        "endpoint": "POST /api/app/medical",
        "description": "Add or update medical information (upsert)",
        "authentication": "Required",
        "request": {
          "bloodType": "A+",
          "height": 175.5,
          "weight": 75.0,
          "chronicDiseases": "Diabetes Type 2, Hypertension",
          "allergies": "Penicillin, Shellfish, Peanuts",
          "medications": "Metformin 500mg twice daily, Lisinopril 10mg once daily",
          "surgeries": "Appendectomy (2015), Knee surgery (2020)",
          "notes": "Patient prefers no ibuprofen due to stomach sensitivity",
          "emergencyInstructions": "Call emergency contact immediately. Patient is diabetic - check blood sugar levels."
        },
        "response_success": {
          "success": true,
          "message": "Medical information saved successfully",
          "data": {
            "medicalID": 1,
            "userID": 1,
            "bloodType": "A+",
            "createdAt": "2025-02-03T17:00:00Z",
            "updatedAt": "2025-02-03T17:00:00Z"
          }
        }
      },

      "10_add_emergency_contact": {
        "endpoint": "POST /api/app/emergency-contact",
        "description": "Add emergency contact",
        "authentication": "Required",
        "request": {
          "contactName": "Jane besso",
          "relation": "Spouse",
          "phoneNumber": "+20123456789",
          "secondaryPhone": "+20198765432",
          "email": "jane.besso@example.com",
          "isPrimary": true,
          "priority": 1,
          "notes": "Available 24/7"
        },
        "response_success": {
          "success": true,
          "message": "Emergency contact added successfully",
          "data": {
            "contactID": 1,
            "userID": 1,
            "contactName": "Jane besso",
            "relation": "Spouse",
            "phoneNumber": "+20123456789",
            "isPrimary": true,
            "priority": 1,
            "createdAt": "2025-02-03T17:00:00Z"
          }
        }
      },

      "11_register_device": {
        "endpoint": "POST /api/app/device",
        "description": "Register device for push notifications",
        "authentication": "Required",
        "request": {
          "deviceName": "iPhone 15 Pro",
          "deviceType": "ios",
          "deviceToken": "fcm_token_abc123xyz789",
          "deviceOS": "iOS 17.2",
          "appVersion": "2.1.0"
        },
        "response_success": {
          "success": true,
          "message": "Device registered successfully",
          "data": {
            "deviceID": 1,
            "userID": 1,
            "deviceName": "iPhone 15 Pro",
            "deviceType": "ios",
            "deviceToken": "fcm_token_abc123xyz789",
            "isActive": true,
            "createdAt": "2025-02-03T17:00:00Z"
          }
        }
      },

      "12_change_password": {
        "endpoint": "POST /api/app/password/change",
        "description": "Change user password",
        "authentication": "Required",
        "request": {
          "currentPassword": "SecurePass123!",
          "newPassword": "NewSecurePass456!"
