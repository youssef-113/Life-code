          "description": "Each user can have multiple wristbands"
        },
        {
          "parent": "Users",
          "child": "EmergencyContacts",
          "foreignKey": "UserID",
          "description": "Each user can have multiple emergency contacts"
        },
        {
          "parent": "Users",
          "child": "SecurityLogs",
          "foreignKey": "UserID",
          "description": "Each user has multiple security log entries"
        },
        {
