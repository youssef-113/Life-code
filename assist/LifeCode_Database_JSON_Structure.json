      "ScanLogs": {
        "description": "QR/NFC scan tracking for analytics and security",
        "schema": {
          "ScanID": {
            "type": "integer",
            "unsigned": true,
            "autoIncrement": true,
            "primaryKey": true,
            "nullable": false,
            "example": 1
          },
          "WristbandID": {
            "type": "integer",
            "unsigned": true,
            "nullable": false,
            "foreignKey": {
              "table": "Wristbands",
              "column": "ID",
              "onDelete": "CASCADE",
              "onUpdate": "CASCADE"
            },
            "indexed": true,
            "example": 1
          },
          "UserID": {
            "type": "integer",
            "unsigned": true,
            "nullable": false,
            "foreignKey": {
              "table": "Users",
              "column": "ID",
              "onDelete": "CASCADE",
              "onUpdate": "CASCADE"
            },
            "indexed": true,
            "example": 1
          },
          "ScanType": {
            "type": "enum",
            "values": ["QR", "NFC"],
            "nullable": false,
            "indexed": true,
            "example": "QR"
          },
          "ScannerType": {
            "type": "enum",
            "values": ["emergency", "hospital", "public", "personal"],
            "default": "public",
            "nullable": true,
            "description": "Type of scanner that performed the scan",
            "example": "emergency"
          },
          "Location": {
            "type": "string",
            "maxLength": 255,
            "nullable": true,
            "description": "GPS coordinates or facility name",
            "example": "Cairo General Hospital"
          },
          "Latitude": {
            "type": "decimal",
            "precision": 10,
            "scale": 8,
            "nullable": true,
            "min": -90,
            "max": 90,
            "example": 30.0444
          },
          "Longitude": {
            "type": "decimal",
            "precision": 11,
            "scale": 8,
            "nullable": true,
            "min": -180,
            "max": 180,
            "example": 31.2357
          },
          "IPAddress": {
            "type": "string",
            "maxLength": 45,
            "nullable": true,
            "example": "41.32.45.78"
          },
          "UserAgent": {
            "type": "text",
            "nullable": true,
            "example": "Mozilla/5.0 (iPhone; CPU iPhone OS 17_2)"
          },
          "Timestamp": {
            "type": "datetime",
            "nullable": false,
            "default": "CURRENT_TIMESTAMP",
            "indexed": true,
            "format": "ISO 8601",
            "example": "2025-02-03T10:00:00.000Z"
          }
        },
        "indexes": [
          {
            "name": "idx_wristband_scans",
            "columns": ["WristbandID", "Timestamp"],
            "type": "COMPOSITE"
          },
          {
            "name": "idx_user_scans",
            "columns": ["UserID", "Timestamp"],
            "type": "COMPOSITE"
          },
          {
            "name": "idx_scan_type",
            "columns": ["ScanType", "Timestamp"],
            "type": "COMPOSITE"
          },
          {
            "name": "idx_timestamp",
            "columns": ["Timestamp"],
            "type": "INDEX"
          }
        ],
        "example_document": {
          "ScanID": 1,
